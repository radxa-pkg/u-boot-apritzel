From e4efdeeeed158f28788e4e65cc459e083a75ab34 Mon Sep 17 00:00:00 2001
From: liaoyongming <liaoyongming@allwinnertech.com>
Date: Mon, 3 Aug 2026 16:00:57 +0800
Subject: [PATCH 1/2] support auto withstand voltage configure for A733-B IC

Signed-off-by: Feng Zhang <feng@radxa.com>
---
 src/arch/arm/include/asm/arch-sunxi/cpu.h             |  9 +++++++++
 src/arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h |  5 +++++
 src/arch/arm/mach-sunxi/cpu_info.c                    | 14 ++++++++++++++
 src/board/sunxi/board.c                               | 13 +++++++++++++
 src/include/sunxi_gpio.h                              |  1 +
 5 files changed, 42 insertions(+)

diff --git a/src/arch/arm/include/asm/arch-sunxi/cpu.h b/src/arch/arm/include/asm/arch-sunxi/cpu.h
index 768c6572d6b..2fc454f650f 100644
--- a/src/arch/arm/include/asm/arch-sunxi/cpu.h
+++ b/src/arch/arm/include/asm/arch-sunxi/cpu.h
@@ -22,4 +22,13 @@
 #define SOCID_H5	0x1718
 #define SOCID_R40	0x1701
 
+enum sunxi_soc_ver {
+	SUNXI_SOC_VER_INVALID = -1,
+	SUNXI_SOC_VER_A = 0,
+	SUNXI_SOC_VER_B = 1,
+	SUNXI_SOC_VER_C = 2,
+};
+
+enum sunxi_soc_ver sunxi_get_soc_ver(void);
+
 #endif /* _SUNXI_CPU_H */
diff --git a/src/arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h b/src/arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h
index 33de01d4716..0e1a489215f 100644
--- a/src/arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h
+++ b/src/arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h
@@ -46,6 +46,11 @@
 
 #ifdef CONFIG_MACH_SUN60I_A733
 #define SUNXI_GIC600_BASE		0x03400000
+
+/* The A733 SoC version is encoded in the system control register. */
+#define SUNXI_SYSCTRL_BASE		0x03000000
+#define SUNXI_SOC_VER_REG		(SUNXI_SYSCTRL_BASE + 0x24)
+#define SUNXI_SOC_VER_MASK		0x7
 #endif
 
 #define SUNXI_MMC0_BASE			0x04020000
diff --git a/src/arch/arm/mach-sunxi/cpu_info.c b/src/arch/arm/mach-sunxi/cpu_info.c
index 74d1e92a825..143d8c10f73 100644
--- a/src/arch/arm/mach-sunxi/cpu_info.c
+++ b/src/arch/arm/mach-sunxi/cpu_info.c
@@ -177,6 +177,20 @@ int sunxi_get_sid(unsigned int *sid)
 	return -ENODEV;
 #endif
 }
+
+enum sunxi_soc_ver sunxi_get_soc_ver(void)
+{
+#ifdef SUNXI_SOC_VER_REG
+	uint32_t value;
+
+	value = readl(SUNXI_SOC_VER_REG);
+	value &= SUNXI_SOC_VER_MASK;
+
+	return SUNXI_SOC_VER_A + value;
+#else
+	return SUNXI_SOC_VER_INVALID;
+#endif
+}
 
 int sunxi_get_serial(unsigned int *serial)
 {
diff --git a/src/board/sunxi/board.c b/src/board/sunxi/board.c
index 65f4c92ba1b..20c5dd90f94 100644
--- a/src/board/sunxi/board.c
+++ b/src/board/sunxi/board.c
@@ -565,6 +565,14 @@ static void sunxi_spl_store_dram_size(phys_addr_t dram_size)
 	spl->dram_size = dram_size >> 20;
 }
 
+#ifdef CONFIG_MACH_SUN60I_A733
+static void sunxi_set_gpio_withstand_voltage_auto(void)
+{
+	writel(0x01155550, SUNXI_PIO_BASE + SUN60I_A733_GPIO_POW_MODE_REG);
+	printf("board gpio withstand voltage auto mode\n");
+}
+#endif
+
 static void status_led_init(void)
 {
 #if CONFIG_IS_ENABLED(SUNXI_LED_STATUS)
@@ -580,6 +588,11 @@ void sunxi_board_init(void)
 {
 	int power_failed = 0;
 
+#ifdef CONFIG_MACH_SUN60I_A733
+	if (sunxi_get_soc_ver() == SUNXI_SOC_VER_B)
+		sunxi_set_gpio_withstand_voltage_auto();
+#endif
+
 	if (CONFIG_IS_ENABLED(SUNXI_LED_STATUS))
 		status_led_init();
 
diff --git a/src/include/sunxi_gpio.h b/src/include/sunxi_gpio.h
index 9b311576d91..434d767dd32 100644
--- a/src/include/sunxi_gpio.h
+++ b/src/include/sunxi_gpio.h
@@ -22,6 +22,7 @@
 #elif defined(CONFIG_MACH_SUN60I_A733)
 #define SUNXI_PIO_BASE		0x02000000
 #define SUNXI_R_PIO_BASE	0x07025000
+#define SUN60I_A733_GPIO_POW_MODE_REG	0x040
 #elif defined(CONFIG_SUNXI_GEN_NCAT2)
 #define SUNXI_PIO_BASE		0x02000000
 #define SUNXI_R_PIO_BASE	0x07022000
-- 
2.43.0
