From 13e20cf75cf54fdc7dc9fa765127e2dd25f1da7a Mon Sep 17 00:00:00 2001
From: Feng Zhang <feng@radxa.com>
Date: Thu, 25 Jun 2026 18:42:26 +0800
Subject: [PATCH] configs: radxa-cubie-a7s: enable PCIe NVMe UFS SPI NOR

Signed-off-by: Feng Zhang <feng@radxa.com>
---
 src/configs/radxa-cubie-a7s_defconfig | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/configs/radxa-cubie-a7s_defconfig b/src/configs/radxa-cubie-a7s_defconfig
index 75f40530d34..d64eaba464d 100644
--- a/src/configs/radxa-cubie-a7s_defconfig
+++ b/src/configs/radxa-cubie-a7s_defconfig
@@ -11,10 +11,15 @@ CONFIG_RADXA_UNIFIED_IMAGE=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x47a00000
 CONFIG_BOOTDELAY=3
+CONFIG_AHCI=y
 CONFIG_FDT_FIXUP_PARTITIONS=y
 CONFIG_SPL_RAM_DEVICE=y
 CONFIG_CMD_DFU=y
 CONFIG_CMD_I2C=y
+CONFIG_CMD_MTD=y
+CONFIG_CMD_UFS=y
+CONFIG_CMD_SF_TEST=y
+CONFIG_CMD_SPI=y
 CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_ADC=y
 CONFIG_SUNXI_GPADC=y
@@ -26,6 +31,18 @@ CONFIG_RADXA_ID_EEPROM=y
 CONFIG_SYS_I2C_EEPROM_ADDR=0x50
 CONFIG_SYS_I2C_EEPROM_ADDR_OVERFLOW=0x7
 CONFIG_SUPPORT_EMMC_BOOT=y
+CONFIG_MTD=y
+CONFIG_MTD_BLOCK=y
+CONFIG_SPI_FLASH_SOFT_RESET=y
+CONFIG_SPI_FLASH_SOFT_RESET_ON_BOOT=y
+CONFIG_SPI_FLASH_MACRONIX=y
+CONFIG_SPI_FLASH_SPANSION=y
+CONFIG_SPI_FLASH_STMICRO=y
+CONFIG_SPI_FLASH_SST=y
+CONFIG_SPI_FLASH_WINBOND=y
+CONFIG_SPI_FLASH_XMC=y
+CONFIG_SPI_FLASH_DATAFLASH=y
+CONFIG_SPI_FLASH_MTD=y
 CONFIG_DM_MDIO=y
 CONFIG_DM_ETH_PHY=y
 CONFIG_DWC_ETH_QOS=y
@@ -37,4 +54,15 @@ CONFIG_USB_EHCI_HCD=y
 CONFIG_USB_OHCI_HCD=y
 CONFIG_USB_MUSB_GADGET=y
 CONFIG_USB_ETH_CDC=y
-CONFIG_SPL_STACK_R_MALLOC_SIMPLE_LEN=0x110000
\ No newline at end of file
+CONFIG_SPL_STACK_R_MALLOC_SIMPLE_LEN=0x140000
+CONFIG_PCI=y
+CONFIG_NVME_PCI=y
+CONFIG_PCIE_SUNXI=y
+CONFIG_AW_CADENCE_COMBOPHY=y
+CONFIG_REGULATOR_AXP=y
+CONFIG_CMD_PCI=y
+CONFIG_SCSI=y
+CONFIG_SCSI_AHCI=y
+CONFIG_SPI=y
+CONFIG_UFS=y
+CONFIG_UFS_SUNXI=y
-- 
