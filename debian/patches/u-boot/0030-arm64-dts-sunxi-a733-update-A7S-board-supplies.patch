From 02d9d7a93ef94b72c82be0ff52af90846dfb2058 Mon Sep 17 00:00:00 2001
From: Feng Zhang <feng@radxa.com>
Date: Thu, 25 Jun 2026 18:41:37 +0800
Subject: [PATCH] arm64: dts: sunxi: a733: update A7S board supplies

Signed-off-by: Feng Zhang <feng@radxa.com>
---
 src/arch/arm/dts/sun60i-a733-cubie-a7s.dts | 36 +++++++++++++++-----------
 1 file changed, 21 insertions(+), 15 deletions(-)

diff --git a/src/arch/arm/dts/sun60i-a733-cubie-a7s.dts b/src/arch/arm/dts/sun60i-a733-cubie-a7s.dts
index 223843654ba..1136c089ea6 100644
--- a/src/arch/arm/dts/sun60i-a733-cubie-a7s.dts
+++ b/src/arch/arm/dts/sun60i-a733-cubie-a7s.dts
@@ -69,7 +69,7 @@
 	mmc-hs200-1_8v;
 	non-removable;
 	vmmc-supply = <&reg_cldo5>;
-	vqmmc-supply = <&reg_dc1sw2>;
+	vqmmc-supply = <&reg_swout2>;
 	status = "okay";
 };
 
@@ -103,7 +103,7 @@
 &gmac0 {
 	phy-mode = "rgmii-id";
 	phy-handle = <&ext_rgmii1_phy>;
-	phy-supply = <&reg_dc1sw1>;
+	phy-supply = <&reg_swout1>;
 
 	tx-internal-delay-ps = <1200>;
 	rx-internal-delay-ps = <1000>;
@@ -148,19 +148,19 @@
 		regulators {
 			reg_dcdc1: dcdc1 {
 				regulator-always-on;
-				regulator-min-microvolt = <900000>;
-				regulator-max-microvolt = <1160000>;
-				regulator-name = "vdd-cpul";
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <3400000>;
+				regulator-name = "vdd-3v3";
 			};
 
-			reg_dc1sw1: dc1sw1 {
+			reg_swout1: swout1 {
 				regulator-always-on;
 				regulator-min-microvolt = <3300000>;
 				regulator-max-microvolt = <3300000>;
 				regulator-name = "vdd-swout1";
 			};
 
-			reg_dc1sw2: dc1sw2 {
+			reg_swout2: swout2 {
 				regulator-always-on;
 				regulator-min-microvolt = <3300000>;
 				regulator-max-microvolt = <3300000>;
@@ -173,6 +173,20 @@
 				regulator-name = "vcc-mipi-dsi";
 			};
 
+			reg_bldo1: bldo1 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc-pe";
+			};
+
+			reg_bldo2: bldo2 {
+				regulator-always-on;
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-name = "vcc-pd";
+			};
+
 			/* Supplies the SYSFB */
 			reg_dcdc2_323: dcdc2 {
 				regulator-always-on;
@@ -199,14 +213,6 @@
 				regulator-name = "vdd-cpul";
 			};
 
-			/* For Board ID detection */
-			reg_bldo1: bldo1 {
-				regulator-always-on;
-				regulator-min-microvolt = <800000>;
-				regulator-max-microvolt = <1000000>;
-				regulator-name = "vcc-pk";
-			};
-
 			reg_cldo1: cldo1 {
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
-- 
2.43.0
