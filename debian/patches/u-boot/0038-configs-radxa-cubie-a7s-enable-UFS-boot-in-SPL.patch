From e3ef18d7208ebc934b06652c0064bfd802013dd4 Mon Sep 17 00:00:00 2001
From: Feng Zhang <feng@radxa.com>
Date: Wed, 15 Jul 2026 17:50:24 +0800
Subject: [PATCH] configs: radxa-cubie-a7s: enable UFS boot in SPL

Signed-off-by: Feng Zhang <feng@radxa.com>
---
 src/configs/radxa-cubie-a7s_defconfig | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/configs/radxa-cubie-a7s_defconfig b/src/configs/radxa-cubie-a7s_defconfig
index dc868b6ba99..ee7cab41282 100644
--- a/src/configs/radxa-cubie-a7s_defconfig
+++ b/src/configs/radxa-cubie-a7s_defconfig
@@ -4,6 +4,11 @@ CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x4F000000
 CONFIG_DEFAULT_DEVICE_TREE="sun60i-a733-cubie-a7s"
 CONFIG_SPL=y
+CONFIG_SPL_DM=y
+CONFIG_SPL_OF_CONTROL=y
+# CONFIG_SPL_DM_I2C is not set
+# CONFIG_SPL_DM_PMIC is not set
+CONFIG_SPL_MAX_SIZE=0x49000
 CONFIG_MACH_SUN60I_A733=y
 CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 # CONFIG_VIDEO_SUNXI is not set
@@ -11,6 +16,9 @@ CONFIG_RADXA_UNIFIED_IMAGE=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x47a00000
 CONFIG_SPL_SPI_SUNXI=y
+CONFIG_SPL_UFS_SUPPORT=y
+CONFIG_SPL_UFS_RAW_U_BOOT_SECTOR=0x14c
+# CONFIG_SPL_DM_SERIAL is not set
 CONFIG_BOOTDELAY=3
 CONFIG_AHCI=y
 CONFIG_FDT_FIXUP_PARTITIONS=y
-- 
2.43.0

