From 382518094a94b4172d9d2ee17157ad966a00161e Mon Sep 17 00:00:00 2001
From: Feng Zhang <feng@radxa.com>
Date: Tue, 14 Jul 2026 19:02:59 +0800
Subject: [PATCH] configs: radxa-cubie-a7s: enable SPI NOR boot in SPL

Signed-off-by: Feng Zhang <feng@radxa.com>
---
 src/configs/radxa-cubie-a7s_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/configs/radxa-cubie-a7s_defconfig b/src/configs/radxa-cubie-a7s_defconfig
index d64eaba464d..dc868b6ba99 100644
--- a/src/configs/radxa-cubie-a7s_defconfig
+++ b/src/configs/radxa-cubie-a7s_defconfig
@@ -10,6 +10,7 @@ CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 CONFIG_RADXA_UNIFIED_IMAGE=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x47a00000
+CONFIG_SPL_SPI_SUNXI=y
 CONFIG_BOOTDELAY=3
 CONFIG_AHCI=y
 CONFIG_FDT_FIXUP_PARTITIONS=y
